{
  "build": {
    "appId": "io.github.dmytroportianka.Parnassus",
    "directories": {
      "output": "dist"
    },
    "files": ["out/**", "package.json", "build/icon.png"],
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "target": ["AppImage", "tar.gz"]
    },
    "productName": "Parnassus"
  },
  "description": "Desktop client for Muse. The wrapper holds no user data: files are copied in on request, edited on the Muse side, and written back only after approval.",
  "author": "Dmytro Portianka",
  "desktopName": "io.github.dmytroportianka.Parnassus",
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.15",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-types": "^1.4.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "name": "parnassus",
  "private": true,
  "scripts": {
    "build": "electron-vite build",
    "dev": "install-electron --no && electron-vite dev",
    "dev:web": "vite dev --config vite.web.config.ts",
    "package": "electron-vite build && electron-builder --linux AppImage tar.gz",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "@astryxdesign/core": "^0.7.15",
    "@astryxdesign/theme-neutral": "^0.7.15",
    "@stylexjs/stylex": "^0.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}